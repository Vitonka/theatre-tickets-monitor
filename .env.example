# Copy to `.env` and fill in. Get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here

# Optional: restrict who can control the bot (comma-separated Telegram user IDs).
# Leave empty to let anyone who finds the bot use it. Find your id via @userinfobot.
ALLOWED_USER_IDS=

# Optional: how often (minutes) to re-check every monitored show.
POLL_INTERVAL_MIN=15
